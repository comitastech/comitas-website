---
/**
 * Band option 2: a classical temple drawn as an architect would on paper,
 * a floor plan (columns, cella walls in hatched poché, steps, axes, a dimension
 * line, compass construction) and a front elevation with the pediment, all
 * in warm ink lines. Original drawing, generated here from plain geometry; no
 * third-party artwork.
 *
 * Lines are slightly wobbled with a seeded generator (the same every build)
 * so they read as hand-drawn. The entrance animation (a slow wipe) is on the
 * whole <svg> and lives in SectionBand.astro.
 */
type Pt = [number, number];

// Seeded pseudo-random numbers, so the drawing is the same on every build.
let seed = 20261128;
const rnd = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const jit = (amount: number) => (rnd() - 0.5) * amount;
const f = (n: number) => String(Math.round(n * 10) / 10);

/** A wobbly straight line: a few intermediate points, each nudged a little. */
const line = (x0: number, y0: number, x1: number, y1: number, wobble = 0.7) => {
  const len = Math.hypot(x1 - x0, y1 - y0);
  const n = Math.max(1, Math.round(len / 46));
  const pts: Pt[] = [[x0 + jit(0.4), y0 + jit(0.4)]];
  for (let i = 1; i < n; i++) {
    const t = i / n;
    pts.push([
      x0 + (x1 - x0) * t + jit(wobble),
      y0 + (y1 - y0) * t + jit(wobble),
    ]);
  }
  pts.push([x1 + jit(0.4), y1 + jit(0.4)]);
  return `M${pts.map(([x, y]) => `${f(x)} ${f(y)}`).join("L")}`;
};
const rect = (x0: number, y0: number, x1: number, y1: number) =>
  [
    line(x0, y0, x1, y0),
    line(x1, y0, x1, y1),
    line(x1, y1, x0, y1),
    line(x0, y1, x0, y0),
  ].join("");
const circle = (cx: number, cy: number, r: number, steps = 28) =>
  `M${Array.from({ length: steps + 1 }, (_, i) => {
    const t = (i / steps) * Math.PI * 2;
    return `${f(cx + (r + jit(0.35)) * Math.cos(t))} ${f(cy + (r + jit(0.35)) * Math.sin(t))}`;
  }).join("L")}Z`;
const arc = (
  cx: number,
  cy: number,
  r: number,
  a0: number,
  a1: number,
  steps = 60,
) =>
  `M${Array.from({ length: steps + 1 }, (_, i) => {
    const t = ((a0 + ((a1 - a0) * i) / steps) * Math.PI) / 180;
    return `${f(cx + r * Math.cos(t))} ${f(cy + r * Math.sin(t))}`;
  }).join("L")}`;

// --- Floor plan ------------------------------------------------------------
const S = 43; // column spacing
const PX = 668; // plan origin (center of the first column)
const PY = 184;
const COLS = 9;
const ROWS = 5;
const pw = (COLS - 1) * S;
const ph = (ROWS - 1) * S;

const colAt: Pt[] = [];
for (let i = 0; i < COLS; i++) {
  for (let j = 0; j < ROWS; j++) {
    if (i === 0 || i === COLS - 1 || j === 0 || j === ROWS - 1)
      colAt.push([PX + i * S, PY + j * S]);
  }
}
// Pronaos: two columns in line with the cella's front wall.
colAt.push(
  [PX + S * 1.55, PY + S * 1.5 + 5],
  [PX + S * 1.55, PY + S * 2.5 - 5],
);

const steps = [12, 22, 32].map((m) =>
  rect(PX - m, PY - m, PX + pw + m, PY + ph + m),
);

// Cella: walls as hatched poché. The left short wall has a door gap.
const WALL = 8;
const cx0 = PX + S * 2;
const cx1 = PX + pw - S;
const cy0 = PY + S;
const cy1 = PY + ph - S;
const door: [number, number] = [PY + S * 1.5 + 2, PY + S * 2.5 - 2];
const wallRects: [number, number, number, number][] = [
  [cx0 - WALL, cy0 - WALL, cx1 + WALL, cy0], // top
  [cx0 - WALL, cy1, cx1 + WALL, cy1 + WALL], // bottom
  [cx1, cy0, cx1 + WALL, cy1], // right
  [cx0 - WALL, cy0, cx0, door[0]], // left, above the door
  [cx0 - WALL, door[1], cx0, cy1], // left, below the door
];
const walls = wallRects.map(([a, b, c, d]) => rect(a, b, c, d));

// Axes (dash-dot) and a compass construction behind the plan.
const midY = PY + ph / 2;
const midX = PX + pw / 2;
const axes = [
  line(PX - 56, midY, PX + pw + 56, midY, 0.3),
  line(midX, PY - 56, midX, PY + ph + 56, 0.3),
];
const construction = [
  arc(midX, midY, pw / 2 + 56, 200, 340),
  arc(midX, midY, pw / 2 + 56, 20, 160),
  arc(PX, midY, pw + 16, -35, 35),
  line(PX - 40, PY - 46, PX + pw + 40, PY + ph + 46, 0.4),
  line(PX - 40, PY + ph + 46, PX + pw + 40, PY - 46, 0.4),
];

// Dimension line under the plan, with ticks at every second column.
const DY = PY + ph + 54;
const dimension = [
  line(PX, DY, PX + pw, DY, 0.2),
  ...Array.from({ length: COLS }, (_, i) =>
    line(
      PX + i * S,
      DY - (i % 2 === 0 ? 7 : 4),
      PX + i * S,
      DY + (i % 2 === 0 ? 7 : 4),
      0.1,
    ),
  ),
];
// Cut mark: a line through the plan with small triangular flags at both ends.
const cutX = PX + S * 5.5;
const cut = [
  line(cutX, PY - 46, cutX, PY + ph + 46, 0.3),
  `M${f(cutX - 6)} ${f(PY - 50)}L${f(cutX + 6)} ${f(PY - 50)}L${f(cutX)} ${f(PY - 38)}Z`,
  `M${f(cutX - 6)} ${f(PY + ph + 50)}L${f(cutX + 6)} ${f(PY + ph + 50)}L${f(cutX)} ${f(PY + ph + 38)}Z`,
];

// --- Front elevation -------------------------------------------------------
const EX = 1262; // center axis
const GY = 446; // ground
const stepsElev = [0, 1, 2].map((i) =>
  rect(EX - 156 + i * 10, GY - (i + 1) * 8, EX + 156 - i * 10, GY - i * 8),
);
const BASE = GY - 24; // top of the stylobate
const centers = [-114, -38, 38, 114].map((d) => EX + d);
const SH = 148; // shaft height
const shafts = centers.map((c) => {
  const top = BASE - SH;
  const w0 = 15;
  const w1 = 12.5;
  const left = `M${f(c - w0)} ${f(BASE)}C${f(c - w0 - 1.4)} ${f(BASE - SH * 0.4)} ${f(c - w1 - 0.6)} ${f(BASE - SH * 0.8)} ${f(c - w1)} ${f(top)}`;
  const right = `M${f(c + w0)} ${f(BASE)}C${f(c + w0 + 1.4)} ${f(BASE - SH * 0.4)} ${f(c + w1 + 0.6)} ${f(BASE - SH * 0.8)} ${f(c + w1)} ${f(top)}`;
  const flutes = [-6.5, 0, 6.5].map((o) =>
    line(c + o, BASE - 4, c + o * 0.85, top + 3, 0.5),
  );
  // Shade on the right: close vertical lines, growing from the middle.
  const shade = Array.from({ length: 9 }, (_, i) => {
    const o = 8 + i * 0.85;
    return line(c + o, BASE - 6, c + o * 0.84, top + 4 + i * 3, 0.3);
  });
  const base = rect(c - 18, BASE - 6, c + 18, BASE);
  const abacus = rect(c - 19, top - 14, c + 19, top - 8);
  const echinus = `M${f(c - 12.5)} ${f(top)}L${f(c - 17)} ${f(top - 8)}M${f(c + 12.5)} ${f(top)}L${f(c + 17)} ${f(top - 8)}`;
  return { left, right, flutes, shade, base, abacus, echinus, top };
});
const capTop = BASE - SH - 14;
const archL = EX - 144;
const archR = EX + 144;
const architrave = rect(archL, capTop - 16, archR, capTop);
const frieze = rect(archL, capTop - 38, archR, capTop - 16);
const triglyphs = Array.from({ length: 9 }, (_, i) => {
  const x = archL + 14 + i * ((archR - archL - 28) / 8);
  return [-3, 0, 3]
    .map((o) => line(x + o, capTop - 36, x + o, capTop - 18, 0.2))
    .join("");
});
const cornice = rect(archL - 8, capTop - 46, archR + 8, capTop - 38);
const apex: Pt = [EX, capTop - 46 - 44];
const pediment = `M${f(archL - 8)} ${f(capTop - 46)}L${f(apex[0])} ${f(apex[1])}L${f(archR + 8)} ${f(capTop - 46)}`;
const tympanum = Array.from({ length: 26 }, (_, i) => {
  const t = (i + 1) / 27;
  const y = capTop - 46 - t * 36;
  const half = ((archR - archL + 16) / 2) * (1 - (t * 36) / 44) - 8;
  return line(EX - half, y, EX + half, y, 0.2);
}).join("");
// Ground line extending across the elevation and into the plan.
const ground = line(EX - 200, GY, EX + 170, GY, 0.4);

const viewBox = "0 0 1440 520";
---

<svg
  class="plan"
  viewBox={viewBox}
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id="plan-hatch"
      patternUnits="userSpaceOnUse"
      width="3.4"
      height="3.4"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="3.4" class="plan-hatch-line"></line>
    </pattern>
  </defs>

  <g>
    {construction.map((d) => (
      <path class="plan-faint" d={d} />
    ))}
    {axes.map((d) => (
      <path class="plan-axis" d={d} />
    ))}
  </g>
  <g>
    {steps.map((d) => (
      <path class="plan-line" d={d} />
    ))}
  </g>
  <g>
    {walls.map((d) => (
      <path class="plan-line" d={d} />
    ))}
    {colAt.map(([x, y]) => (
      <>
        <path class="plan-line" d={circle(x, y, 7.5)} />
        <path
          class="plan-line"
          d={circle(x, y, 4.2, 20)}
          fill="url(#plan-hatch)"
        />
        <path class="plan-line" d={line(x - 7.5, y, x + 7.5, y, 0.1)} />
        <path class="plan-line" d={line(x, y - 7.5, x, y + 7.5, 0.1)} />
      </>
    ))}
  </g>
  <g>
    {wallRects.map(([a, b, c, d]) => (
      <rect x={a} y={b} width={c - a} height={d - b} fill="url(#plan-hatch)" />
    ))}
  </g>
  <g>
    {dimension.map((d) => (
      <path class="plan-line" d={d} />
    ))}
    {cut.map((d) => (
      <path class="plan-line" d={d} />
    ))}
  </g>

  <g>
    <path class="plan-faint" d={ground} />
    {stepsElev.map((d) => (
      <path class="plan-line" d={d} />
    ))}
  </g>
  <g>
    {shafts.map((s) => (
      <>
        <path class="plan-line" d={s.base} />
        <path class="plan-line" d={s.left} />
        <path class="plan-line" d={s.right} />
        {s.flutes.map((d) => (
          <path class="plan-faint" d={d} />
        ))}
        {s.shade.map((d) => (
          <path class="plan-hair" d={d} />
        ))}
        <path class="plan-line" d={s.echinus} />
        <path class="plan-line" d={s.abacus} />
      </>
    ))}
  </g>
  <g>
    <path class="plan-line" d={architrave} />
    <path class="plan-line" d={frieze} />
    {triglyphs.map((d) => (
      <path class="plan-faint" d={d} />
    ))}
    <path class="plan-line" d={cornice} />
    <path class="plan-line" d={pediment} />
    <path class="plan-hair" d={tympanum} />
  </g>
</svg>

<style>
  .plan {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plan path,
  .plan rect,
  .plan line {
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .plan-line {
    fill: none;
    stroke: var(--plan-ink);
    stroke-width: 1;
  }

  .plan-bold {
    fill: none;
    stroke: var(--plan-ink);
    stroke-width: 1.6;
  }

  .plan-faint {
    fill: none;
    stroke: var(--plan-ink);
    stroke-opacity: 0.45;
    stroke-width: 1;
  }

  .plan-hair {
    fill: none;
    stroke: var(--plan-ink);
    stroke-opacity: 0.4;
    stroke-width: 0.6;
  }

  .plan-axis {
    fill: none;
    stroke: var(--plan-ink);
    stroke-opacity: 0.55;
    stroke-width: 1;
    stroke-dasharray: 10 3 2 3;
  }

  .plan-hatch-line {
    stroke: var(--plan-ink);
    stroke-opacity: 0.7;
    stroke-width: 0.8;
  }

  .plan rect {
    stroke: none;
  }
</style>
