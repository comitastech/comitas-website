---
/**
 * Floating footer: a dark panel inset from the page edges, aligned with the
 * page container. Wordmark at the bottom left; links and legal line on the
 * right (docs/design.md, "Layout").
 */
import Wordmark from "../assets/brand/comitas-wordmark-white.svg";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="footer container-page pb-(--page-margin)">
  <div class="flex min-h-[22rem] flex-col justify-between gap-16 rounded-panel bg-inverse p-6 text-on-inverse md:min-h-[26rem] md:p-8 lg:p-10">
    <nav aria-label="Rodapé" class="grid-12">
      <ul class="col-span-12 flex flex-col gap-4 md:col-span-4 md:col-start-9 lg:col-span-3 lg:col-start-10">
        {site.nav.map((item) => (
          <li>
            <a class="type-label link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            class="type-label link"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <!-- The empty column between logo and legal line keeps the brand's clear
         space (at least the width of the Λ) on desktop. -->
    <div class="grid-12 items-end gap-y-12">
      <p class="col-span-12 lg:col-span-7">
        <Wordmark
          class="block h-auto w-full"
          role="img"
          aria-label={site.name}
        />
      </p>
      <!-- Two deliberate lines on desktop; one flowing line on small screens. -->
      <p class="type-caption col-span-12 text-on-inverse-muted lg:col-span-4 lg:col-start-9 lg:flex lg:flex-col lg:items-end lg:gap-1">
        <span>
          © {year} {site.name}. Todos os direitos reservados.
        </span>
        <span aria-hidden="true" class="lg:hidden">
          {" "}
          ·{" "}
        </span>
        <span class="whitespace-nowrap">
          {site.country}
          <span aria-hidden="true"> · </span>
          <a
            class="link text-on-inverse"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    --focus-ring: var(--color-on-inverse);
  }

  .footer ::selection {
    background-color: var(--color-on-inverse);
    color: var(--color-inverse);
  }
</style>
