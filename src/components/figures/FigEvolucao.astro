---
/**
 * FIG_ 05 [ evolução ]: the same system in three versions, growing floor by
 * floor as the business grows. Each version has a tag tied to its tower by a
 * dashed guide, and the next floor of v1 and v2 is outlined (what v2 and v3
 * add). The latest one is live (the section's single accent).
 * "Depois que entra no ar, o sistema acompanha o negócio."
 */
import { createIso, type Point } from "../../lib/iso";

const k = createIso();

const W = 40; // tower footprint
const FLOOR = 20;
const PITCH = 74; // distance between towers along x
const X0 = 14;
const Y0 = 6; // thin rim behind the towers
const YF = 24; // room in front of the towers, for the tags
const SX = X0 * 2 + PITCH * 2 + W;
const SY = Y0 + W + YF;
const base = k.box(0, 0, -6, SX, SY, 6);

const towers = [1, 2, 3].map((floors, i) => {
  const x = X0 + i * PITCH;
  const height = floors * FLOOR;
  // Front-bottom corner of the tower; the guide drops straight down from it
  // across the plate and out through the front edge, to the tag.
  const corner = k.project(x + W, Y0 + W, 0);
  const edge = k.project(x + W + YF, SY, 0);
  const tagAt = k.include([edge[0], edge[1] + 22]);
  // The next floor, outlined (v1 -> v2, v2 -> v3).
  const ghostZ = height + FLOOR;
  const ghost =
    floors < 3
      ? [
          k.rect(x, Y0, x + W, Y0 + W, ghostZ),
          k.open([k.project(x, Y0 + W, height), k.project(x, Y0 + W, ghostZ)]),
          k.open([
            k.project(x + W, Y0 + W, height),
            k.project(x + W, Y0 + W, ghostZ),
          ]),
          k.open([k.project(x + W, Y0, height), k.project(x + W, Y0, ghostZ)]),
        ]
      : [];
  return {
    floors: Array.from({ length: floors }, (_, f) =>
      k.box(x, Y0, f * FLOOR, W, W, FLOOR),
    ),
    label: `v${i + 1}`,
    guide: k.open([corner, edge, [edge[0], edge[1] + 8] as Point]),
    tagAt,
    ghost,
    height,
    x,
  };
});

// Live mark on the latest version: a mast with a dot and signal arcs.
const last = towers[towers.length - 1];
const mastBase = k.project(last.x + W / 2, Y0 + W / 2, last.height);
const mastTop = k.project(last.x + W / 2, Y0 + W / 2, last.height + 20);
const mast = k.open([mastBase, mastTop]);
const signal = [8, 13].flatMap((r) =>
  [-1, 1].map((side) => {
    const a0 = (side > 0 ? -38 : 180 - 38) * (Math.PI / 180);
    const a1 = (side > 0 ? 38 : 180 + 38) * (Math.PI / 180);
    const pts: Point[] = Array.from({ length: 9 }, (_, i) => {
      const t = a0 + ((a1 - a0) * i) / 8;
      return k.include([
        mastTop[0] + r * Math.cos(t),
        mastTop[1] + r * Math.sin(t),
      ]);
    });
    return k.open(pts);
  }),
);

const viewBox = k.canvas();
---

<svg
  class="drw"
  viewBox={viewBox}
  role="img"
  aria-label="O mesmo sistema em três versões, crescendo andar por andar, cada uma com sua etiqueta; a última está no ar."
>
  <g class="rv" style="--rv-i: 0">
    <path class="drw-left" d={base.left} />
    <path class="drw-right" d={base.right} />
    <path class="drw-top" d={base.top} />
  </g>
  {towers.map((t, i) => (
    <>
      <g class="rv" style={`--rv-i: ${i * 2 + 1}`}>
        <path class="drw-guide" d={t.guide} />
        <text
          class="drw-text"
          x={t.tagAt[0]}
          y={t.tagAt[1]}
          text-anchor="middle"
        >
          {t.label}
        </text>
      </g>
      {t.floors.map((f, j) => (
        <g class="rv" style={`--rv-i: ${i * 2 + j + 1}; --rv-y: 12px`}>
          <path class="drw-left" d={f.left} />
          <path class="drw-right" d={f.right} />
          <path class="drw-top" d={f.top} />
        </g>
      ))}
      {t.ghost.length > 0 && (
        <g class="rv" style={`--rv-i: ${i * 2 + 3}`}>
          {t.ghost.map((d) => (
            <path class="drw-guide" d={d} />
          ))}
        </g>
      )}
    </>
  ))}
  <g class="rv" style="--rv-i: 7; --rv-y: 6px">
    <path class="drw-edge" d={mast} />
    {signal.map((d) => (
      <path class="drw-accent-line" d={d} />
    ))}
    <circle class="drw-accent" cx={mastTop[0]} cy={mastTop[1]} r="3.5" />
  </g>
</svg>
