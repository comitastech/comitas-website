---
/**
 * FIG_ 02 [ conversa ]: a phone standing in a small dock on the table,
 * facing us, with the conversation on its screen (a message, a reply, a
 * voice note, someone typing), next to a cup of coffee with room around it.
 * "Você explica a ideia do jeito que ela está hoje."
 */
import { createIso, type Point } from "../../lib/iso";

const k = createIso();

// Table top.
const table = k.box(0, 0, -6, 176, 124, 6);

// Phone standing at (PX, PY) in a low dock, screen facing the viewer.
// a: across the screen (left -> right), b: up.
const PX = 78,
  PY = 76;
const HW = 30; // half width
const PH = 104; // height
const T = 7; // thickness (seen as the top band)
const DH = 5; // dock height: the phone stands on it
const front = (a: number, b: number) => k.upright(PX, PY, DH, a, b);
// Behind the front plane: (-1, -1) / √2 in plan, i.e. straight up on screen.
const back = (a: number, b: number): Point =>
  k.project(
    PX + a / Math.SQRT2 - T / Math.SQRT2,
    PY - a / Math.SQRT2 - T / Math.SQRT2,
    DH + b,
  );
/** Point on the table plane, `a` across (screen-horizontal), `d` toward us. */
const flat = (a: number, d: number, z = 0) =>
  k.project(PX + (a + d) / Math.SQRT2, PY + (d - a) / Math.SQRT2, z);

// Dock: a low block the phone stands in, a little wider than the phone.
const DA = HW + 7; // half width
const D0 = -T - 6; // back edge
const D1 = 9; // front edge
const dockTop = k.closed([
  flat(-DA, D0, DH),
  flat(DA, D0, DH),
  flat(DA, D1, DH),
  flat(-DA, D1, DH),
]);
const dockFront = k.closed([
  flat(-DA, D1, DH),
  flat(DA, D1, DH),
  flat(DA, D1, 0),
  flat(-DA, D1, 0),
]);
// Soft shadow on the table, falling to the right of the dock.
const dockShadow = k.closed([
  flat(-DA + 6, D1, 0),
  flat(DA, D1, 0),
  flat(DA + 20, D1 + 6, 0),
  flat(-DA + 20, D1 + 6, 0),
]);

const phoneFront = k.closed([
  front(-HW, 0),
  front(HW, 0),
  front(HW, PH),
  front(-HW, PH),
]);
const phoneTop = k.closed([
  front(-HW, PH),
  front(HW, PH),
  back(HW, PH),
  back(-HW, PH),
]);
const screen = k.closed([
  front(-HW + 4, 9),
  front(HW - 4, 9),
  front(HW - 4, PH - 11),
  front(-HW + 4, PH - 11),
]);
const speaker = k.open([front(-6, PH - 5.5), front(6, PH - 5.5)]);

/** Rectangle on the screen, in screen coordinates (a0..a1, b0..b1). */
const box = (a0: number, a1: number, b0: number, b1: number) =>
  k.closed([front(a0, b0), front(a1, b0), front(a1, b1), front(a0, b1)]);

// Messages, top to bottom.
const L = -HW + 8; // incoming bubbles start
const Rr = HW - 8; // outgoing bubbles end
const incoming = box(L, 8, 80, 89);
const reply = box(-6, Rr, 67, 76);
const voice = box(L, 14, 44, 60);
const play = k.closed([front(L + 4, 48), front(L + 4, 56), front(L + 10, 52)]);
const wave = [3, 7, 10, 6, 9, 12, 8, 5, 9, 6, 4, 7].map((h, i) => {
  const a = L + 14 + i * 2.4;
  return k.open([front(a, 52 - h / 2), front(a, 52 + h / 2)]);
});
const reply2 = box(2, Rr, 31, 41);
const typing = box(L, L + 18, 16, 25);
const dots = [L + 5, L + 9, L + 13].map((a) => {
  const [x, y] = front(a, 20.5);
  return { x, y };
});

// Cup of coffee on the table, to the right of the phone, with a handle and steam.
const CX = 140,
  CY = 50,
  R = 15,
  H = 26;
const cupShadow = k.circle(CX + 8, CY - 8, R, 0, 40);
const cup = k.cylinder(CX, CY, 0, R, H);
const coffee = k.circle(CX, CY, R - 3, H, 40);
const handle = (() => {
  const p0 = k.upright(CX, CY, 0, R - 1, 20);
  const c = k.upright(CX, CY, 0, R + 11, 14);
  const p1 = k.upright(CX, CY, 0, R - 1, 7);
  return `M${k.pt(p0)}Q${k.pt(c)} ${k.pt(p1)}`;
})();
const steam = [-4, 4].map((a0, j) =>
  k.open(
    Array.from({ length: 11 }, (_, i) => {
      const b = H + 6 + i * 2;
      const a = a0 + 2.2 * Math.sin(i * 0.9 + j * 1.7);
      return k.upright(CX, CY, 0, a, b);
    }),
  ),
);

const viewBox = k.canvas();
---

<svg
  class="drw"
  viewBox={viewBox}
  role="img"
  aria-label="Celular em pé sobre a mesa com uma conversa na tela: uma mensagem, respostas, um áudio e alguém digitando; ao lado, uma xícara de café."
>
  <g class="rv" style="--rv-i: 0">
    <path class="drw-left" d={table.left} />
    <path class="drw-right" d={table.right} />
    <path class="drw-top" d={table.top} />
  </g>
  <g class="rv" style="--rv-i: 1">
    <path class="drw-shade" d={dockShadow} />
    <path class="drw-top" d={dockTop} />
    <path class="drw-right" d={dockFront} />
    <path class="drw-right" d={phoneTop} />
    <path class="drw-top" d={phoneFront} />
    <path class="drw-line" d={screen} />
    <path class="drw-line" d={speaker} />
  </g>
  <g class="rv" style="--rv-i: 2; --rv-y: 4px">
    <path class="drw-shade" d={incoming} />
    <path class="drw-line" d={incoming} />
  </g>
  <g class="rv" style="--rv-i: 3; --rv-y: 4px">
    <path class="drw-line" d={reply} />
  </g>
  <g class="rv" style="--rv-i: 4; --rv-y: 4px">
    <path class="drw-shade" d={voice} />
    <path class="drw-line" d={voice} />
    <path class="drw-fill-muted" d={play} />
    {wave.map((d) => (
      <path class="drw-line" d={d} />
    ))}
  </g>
  <g class="rv" style="--rv-i: 5; --rv-y: 4px">
    <path class="drw-line" d={reply2} />
  </g>
  <g class="rv" style="--rv-i: 6; --rv-y: 4px">
    <path class="drw-shade" d={typing} />
    <path class="drw-line" d={typing} />
    {dots.map((p) => (
      <circle class="drw-fill-muted" cx={p.x} cy={p.y} r="1.3" />
    ))}
  </g>
  <g class="rv" style="--rv-i: 2">
    <path class="drw-shade" d={cupShadow} />
    <path class="drw-edge" d={handle} />
    <path class="drw-right" d={cup.side} />
    <path class="drw-top" d={cup.top} />
    <path class="drw-shade" d={coffee} />
    <path class="drw-line" d={coffee} />
    {steam.map((d) => (
      <path class="drw-guide" d={d} />
    ))}
  </g>
</svg>
