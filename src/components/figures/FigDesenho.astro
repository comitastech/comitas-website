---
/**
 * FIG_ 03 [ desenho ]: a written agreement on the table. A short list in
 * priority order (the first item highlighted and checked), two signatures
 * and a pencil. "Decidimos juntos o que vem primeiro e deixamos tudo
 * combinado por escrito."
 */
import { createIso } from "../../lib/iso";

const k = createIso();

const table = k.box(0, 0, -6, 172, 146, 6);

// Sheet of paper with a soft offset shadow.
const PZ = 0.6;
const shadow = k.rect(19, 15, 131, 139, 0.1);
const sheet = k.rect(16, 10, 128, 134, PZ);

// Title block.
const title = k.rect(26, 20, 76, 28, PZ);

// List: three items, first one is "what comes first". Big enough to read at
// column width: square boxes, two lines each.
const rows = [45, 64, 83];
const highlight = k.rect(22, 36, 122, 54, PZ);
const items = rows.flatMap((y, i) => [
  k.rect(27, y - 4.5, 36, y + 4.5, PZ),
  k.seg(43, y - 2.5, 114 - i * 12, y - 2.5, PZ),
  k.seg(43, y + 3, 88 - i * 6, y + 3, PZ),
]);
const check = k.poly(
  [
    [28.5, 45],
    [31.5, 48.5],
    [35, 41.5],
  ],
  PZ,
);

// Divider and two signatures ("combinado por escrito").
const divider = k.seg(26, 98, 118, 98, PZ);
const signature = (x0: number, x1: number, phase: number) => {
  const n = 28;
  const scribble = k.open(
    Array.from({ length: n + 1 }, (_, i) => {
      const t = i / n;
      const x = x0 + (x1 - x0) * t;
      const y =
        117 -
        5.5 * Math.sin(t * Math.PI * 3 + phase) * Math.sin(t * Math.PI) -
        1.5 * Math.sin(t * Math.PI * 9 + phase);
      return k.project(x, y, PZ);
    }),
  );
  return { scribble, line: k.seg(x0 - 2, 123, x1 + 2, 123, PZ) };
};
const signatures = [signature(28, 64, 0), signature(78, 118, 1.4)];

// Pencil lying along y, to the right of the sheet.
const PX = 144,
  PW = 9,
  P0 = 16,
  P1 = 108;
const pencil = k.box(PX, P0, 0, PW, P1 - P0, PW);
const ferrule = [
  k.seg(PX, P0 + 10, PX + PW, P0 + 10, PW),
  k.open([k.project(PX + PW, P0 + 10, PW), k.project(PX + PW, P0 + 10, 0)]),
];
const eraser = k.rect(PX, P0, PX + PW, P0 + 10, PW);
const apex = k.project(PX + PW / 2, P1 + 16, PW / 2);
const tipTop = k.closed([
  k.project(PX, P1, PW),
  k.project(PX + PW, P1, PW),
  apex,
]);
const tipSide = k.closed([
  k.project(PX + PW, P1, PW),
  k.project(PX + PW, P1, 0),
  apex,
]);
const tipFront = k.closed([
  k.project(PX, P1, PW),
  k.project(PX, P1, 0),
  k.project(PX + PW, P1, 0),
  apex,
]);
const lead = k.closed([
  k.project(PX + PW / 2 - 1.6, P1 + 11, PW / 2 + 1),
  k.project(PX + PW / 2 + 1.6, P1 + 11, PW / 2 + 1),
  apex,
]);

const viewBox = k.canvas();
---

<svg
  class="drw"
  viewBox={viewBox}
  role="img"
  aria-label="Folha sobre a mesa com uma lista em ordem de prioridade, o primeiro item marcado, duas assinaturas e um lápis ao lado."
>
  <g class="rv" style="--rv-i: 0">
    <path class="drw-left" d={table.left} />
    <path class="drw-right" d={table.right} />
    <path class="drw-top" d={table.top} />
  </g>
  <g class="rv" style="--rv-i: 1">
    <path class="drw-shade" d={shadow} />
    <path class="drw-top" d={sheet} />
    <path class="drw-shade" d={title} />
    <path class="drw-shade" d={highlight} />
    {items.map((d) => (
      <path class="drw-line" d={d} />
    ))}
    <path class="drw-line" d={divider} />
  </g>
  <g class="rv" style="--rv-i: 3; --rv-y: 4px">
    <path class="drw-edge" d={check} />
  </g>
  <g class="rv" style="--rv-i: 4; --rv-y: 4px">
    {signatures.map((s) => (
      <>
        <path class="drw-guide" d={s.line} />
        <path class="drw-edge" d={s.scribble} />
      </>
    ))}
  </g>
  <g class="rv" style="--rv-i: 2; --rv-y: 14px">
    <path class="drw-left" d={tipFront} />
    <path class="drw-left" d={pencil.left} />
    <path class="drw-right" d={pencil.right} />
    <path class="drw-top" d={pencil.top} />
    <path class="drw-shade" d={eraser} />
    <path class="drw-line" d={eraser} />
    {ferrule.map((d) => (
      <path class="drw-line" d={d} />
    ))}
    <path class="drw-right" d={tipSide} />
    <path class="drw-top" d={tipTop} />
    <path class="drw-fill-muted" d={lead} />
  </g>
</svg>
