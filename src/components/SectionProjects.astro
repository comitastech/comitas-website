---
/**
 * Section 5, "Projetos" (docs/copy.md): two projects, each a card with a
 * real screenshot of the client's home page (captured at 1440 x 900, 2x,
 * after the page settled; both heroes rotate, so the alt text describes the
 * captured frame).
 */
import SectionLabel from "./SectionLabel.astro";
import ProjectCard from "./ProjectCard.astro";
import krebs from "../assets/projects/krebs-home.jpg";
import mescla from "../assets/projects/mescla-home.jpg";

const projects = [
  {
    href: "https://krebsmais.com.br",
    domain: "krebsmais.com.br",
    title: "Krebs+ Arquitetura Paisagística.",
    text: "Site institucional em três idiomas.",
    figNumber: 6,
    figName: "krebs+",
    image: krebs,
    alt: "Página inicial do site da Krebs+: foto em tela cheia de uma casa moderna de dois andares com brises escuros, cercada por jardim tropical, com um morro de pedra ao fundo; no topo, o logo, o menu, a escolha de idioma PT, EN e ES e o botão Contato; embaixo, a legenda Jardim FLV e o botão Ver projeto.",
  },
  {
    href: "https://mesclaprod.me",
    domain: "mesclaprod.me",
    title: "Mescla Produtora.",
    text: "Site institucional para produtora audiovisual.",
    figNumber: 7,
    figName: "mescla",
    image: mescla,
    alt: "Página inicial do site da Mescla Produtora: vídeo em tela cheia com a fachada de um prédio em tons de cinza e amarelo, o nome MESCLA em destaque, a frase Contar e transformar histórias e o botão Iniciar um projeto; no topo, o menu com Nosso trabalho, Serviços e Contato.",
  },
];
---

<section class="container-page" aria-labelledby="projetos">
  <div class="section-space border-t border-line" data-reveal>
    <div class="grid-12">
      <SectionLabel index={5} as="h2" id="projetos" class="rv col-span-12">
        Projetos
      </SectionLabel>
    </div>
    <ul class="mt-12 grid-12 gap-y-16 lg:mt-16">
      {projects.map((project, i) => (
        <li class="rv col-span-12 md:col-span-6" style={`--rv-i: ${i + 1}`}>
          <ProjectCard {...project} />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import "../scripts/reveal";
</script>
