---
/**
 * Project card: a real screenshot of the client's home page in an image
 * frame, the FIG_ caption with the domain, title and description. The whole
 * card is one external link.
 *
 * States: hover / keyboard focus zoom the screenshot ~2% inside its crop,
 * shift the arrow 2px and draw the domain's underline (focus also shows an
 * outline); pressed retracts the card slightly. With reduced motion, only
 * the underline's color changes.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import FigureFrame from "./figures/FigureFrame.astro";

interface Props {
  href: string;
  domain: string;
  title: string;
  text: string;
  figNumber: number;
  figName: string;
  image: ImageMetadata;
  alt: string;
}

const { href, domain, title, text, figNumber, figName, image, alt } =
  Astro.props;
const name = title.replace(/\.$/, "");
---

<a
  class="project"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name}, abre ${domain} em nova aba`}
>
  <FigureFrame number={figNumber} name={figName} variant="image">
    <div class="shot">
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1280, 1600]}
        sizes="(min-width: 768px) 46vw, 100vw"
        loading="lazy"
        decoding="async"
        class="shot-img"
      />
    </div>
    <span slot="aside" class="domain text-fg">
      <span class="domain-text">{domain}</span>
      <svg
        class="arrow"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        aria-hidden="true"
      >
        <path d="M2.5 9.5l7-7M4 2.5h5.5V8"></path>
      </svg>
    </span>
  </FigureFrame>
  <h3 class="type-h3 mt-6">{title}</h3>
  <p class="type-body mt-2 max-w-[40ch] text-fg-muted">{text}</p>
</a>

<style>
  .project {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: 2px;
    outline: 1px solid transparent;
    outline-offset: 8px;
    transition:
      outline-color var(--duration-base) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
    -webkit-tap-highlight-color: transparent;
  }

  .project:focus-visible {
    outline-color: var(--focus-ring);
  }

  .shot {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: var(--color-line);
  }

  .project :global(.shot-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .domain {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .domain-text {
    position: relative;
  }

  .domain-text::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -0.25em;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition:
      transform var(--duration-slow) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  .arrow {
    width: 10px;
    height: 10px;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  /* Hover (pointer devices only) and keyboard focus. */
  @media (hover: hover) {
    .project:hover :global(.shot-img) {
      transform: scale(1.02);
    }

    .project:hover .arrow {
      transform: translate(2px, -2px);
    }

    .project:hover .domain-text::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .project:focus-visible :global(.shot-img) {
    transform: scale(1.02);
  }

  .project:focus-visible .arrow {
    transform: translate(2px, -2px);
  }

  .project:focus-visible .domain-text::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Pressed. */
  .project:active {
    transform: scale(0.99);
  }

  /* Reduced motion: underline always drawn; hover and focus only change its
     color. No zoom, no arrow shift, no press scale. */
  @media (prefers-reduced-motion: reduce) {
    .project,
    .project:active,
    .project :global(.shot-img),
    .project:hover :global(.shot-img),
    .project:focus-visible :global(.shot-img),
    .arrow,
    .project:hover .arrow,
    .project:focus-visible .arrow {
      transform: none;
    }

    .domain-text::after,
    .project:hover .domain-text::after,
    .project:focus-visible .domain-text::after {
      transform: scaleX(1);
      background-color: var(--color-border);
      transition: background-color var(--duration-base) var(--ease-standard);
    }

    .project:hover .domain-text::after,
    .project:focus-visible .domain-text::after {
      background-color: currentColor;
    }
  }
</style>
