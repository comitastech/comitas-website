---
/**
 * Site header: approved wordmark (black), discreet size. Navigation arrives
 * with the section PRs.
 */
import Wordmark from "../assets/brand/comitas-wordmark-black.svg";
import { site } from "../config/site";
---

<header class="container-page">
  <div class="flex h-16 items-center lg:h-20">
    <a class="logo-link" href="/" aria-label={`${site.name}, página inicial`}>
      <Wordmark class="block h-4 w-auto" aria-hidden="true" />
    </a>
  </div>
</header>

<style>
  .logo-link {
    display: inline-flex;
    border-radius: 2px;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  @media (hover: hover) {
    .logo-link:hover {
      opacity: 0.64;
    }
  }

  .logo-link:active {
    opacity: 0.48;
  }
</style>
