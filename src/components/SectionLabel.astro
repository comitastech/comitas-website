---
/**
 * Section label in the `[ 01 ] COMO TRABALHAMOS` format (docs/design.md).
 */
interface Props {
  index: number;
  /** Element to render: a heading when the label names its section. */
  as?: "p" | "h2" | "h3";
  id?: string;
  class?: string;
}

const { index, as: Tag = "p", id, class: className } = Astro.props;
const number = String(index).padStart(2, "0");
---

<Tag id={id} class:list={["type-label text-fg-muted", className]}>
  <span class="text-fg-subtle" aria-hidden="true">
    [{" "}
  </span>
  {number}
  <span class="text-fg-subtle" aria-hidden="true">
    {" "}
    ]
  </span>
  <span class="ms-2 text-fg">
    <slot />
  </span>
</Tag>
