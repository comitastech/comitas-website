---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import HeroIllustration from "../components/HeroIllustration.astro";
import SectionBand from "../components/SectionBand.astro";
import SectionContact from "../components/SectionContact.astro";
import SectionHow from "../components/SectionHow.astro";
import SectionWhat from "../components/SectionWhat.astro";
import SectionWho from "../components/SectionWho.astro";
import { contactHref, site } from "../config/site";

// Copy: docs/copy.md, "1. Topo". The H1 shows the same sentence split into
// its two lines ("DO MESMO / LADO DA MESA.").
const title = "Do mesmo lado da mesa.";
---

<BaseLayout title={`Comitas · ${title}`} description={site.heroLead}>
  <section class="container-page" aria-labelledby="hero-title">
    <div class="grid-12 items-center gap-y-14 pt-10 pb-(--section-space) lg:min-h-[calc(100svh-5rem)] lg:pt-0">
      <div class="col-span-12 flex flex-col items-start md:col-span-9 lg:col-span-6">
        <h1 id="hero-title" class="type-display">
          <span class="block">Do mesmo</span>
          <span class="block">lado da mesa.</span>
        </h1>
        <p class="type-body-lg mt-6 max-w-[34ch] text-fg-muted">
          {site.heroLead}
        </p>
        <Button
          class="mt-10"
          href={contactHref}
          arrow="external"
          target="_blank"
        >
          Conversar no WhatsApp
        </Button>
      </div>
      <div class="col-span-12 sm:col-span-10 sm:col-start-2 md:col-span-8 md:col-start-3 lg:col-span-6 lg:col-start-7">
        <HeroIllustration />
      </div>
    </div>
  </section>

  <SectionWho />
  <SectionHow />
  <SectionBand />
  <SectionWhat />
  <SectionContact />
</BaseLayout>
