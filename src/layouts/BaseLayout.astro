---
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { indexing, NOINDEX } from "../config/indexing";
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Keeps this page out of search engines even when the site is indexable
   * (internal pages such as /design). While `indexing.allowed` is false every
   * page is noindex anyway.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const blockIndexing = noindex || !indexing.allowed;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <!-- Marks JS as available before paint, so scroll reveals can start
         hidden without hiding content when JS is off. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {blockIndexing && <meta name="robots" content={NOINDEX} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f9f9f9" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
